NODE_ENV=development
PORT=4000

# Postgres local o de Render. Si es de Render, pon DATABASE_SSL=true
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/gym_saas
DATABASE_SSL=false

# Cadena larga y aleatoria (minimo 16 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173

# Usados por `npm run seed` para crear el super admin
SUPERADMIN_NAME=Guillermo
SUPERADMIN_EMAIL=admin@gymsaas.do
SUPERADMIN_PASSWORD=cambia-esta-password
